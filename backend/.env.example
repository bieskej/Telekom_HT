DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/ht_eronet

JWT_SECRET=ht-eronet-dev-secret-promijeni-u-produkciji

# CORS (dev frontend) — oba URL-a ako koristiš direktan API (VITE_API_URL=http://127.0.0.1:8004)
# Zadano u config.py: localhost:5173 i 127.0.0.1:5173



# SMTP — dev (preporučeno): smtp4dev Desktop

# Instaliraj smtp4dev, pokreni app (SMTP port 25), pregled poruka u Web UI (npr. http://localhost:5000).

# SMTP_USER i SMTP_PASSWORD moraju biti popunjeni — smtp_configured() inače vraća false (smtp4dev auth ne provjerava).

SMTP_HOST=127.0.0.1

SMTP_PORT=25

SMTP_USER=dev

SMTP_PASSWORD=dev

SMTP_FROM=noreply@eronet.ba

SMTP_USE_TLS=false



# Admin obavijesti (iskorištenost, tjedni digest)

ADMIN_ALERT_EMAIL=admin@eronet.ba



# Alternativa: Mailtrap Sandbox (https://mailtrap.io/ → Email Testing → SMTP)

# SMTP_HOST=sandbox.smtp.mailtrap.io

# SMTP_PORT=587

# SMTP_USER=your_mailtrap_username

# SMTP_PASSWORD=your_mailtrap_password

# SMTP_USE_TLS=true

